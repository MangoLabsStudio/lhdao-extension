{
  "name": "lhdao-extension",
  "version": "0.2.1",
  "description": "Lighthouse browser extension — complete engagement and product-experience tasks",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:edge": "wxt build -b edge",
    "zip": "wxt zip",
    "zip:edge": "wxt zip -b edge",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "compile": "wxt prepare",
    "icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "test": "vitest run",
    "test:manifests": "vitest run scripts/verify-product-manifests.test.ts",
    "verify:manifests": "node scripts/verify-product-manifests.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "md5": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/chrome": "^0.0.270",
    "@types/md5": "^2.3.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@wxt-dev/module-react": "^1.1.3",
    "fake-indexeddb": "^6.2.4",
    "happy-dom": "^20.9.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.18",
    "wxt": "^0.20.0"
  },
  "packageManager": "pnpm@10.8.1",
  "pnpm": {
    "overrides": {
      "@vitejs/plugin-react": "^4.4.1"
    }
  }
}
